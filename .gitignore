# Binaries
bin/
backend/.gocache/
backend/server
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work

# Environment variables (NEVER commit these - contain secrets)
.env
.env.local
.env.dev
.env.production
.env.staging
.env*.local
*.env

# Credentials and secrets (NEVER commit)
credentials.json
secrets.json
*.key
*.p12
*.pfx
service-account*.json
*-credentials.json
*-secrets.json
# Note: CA certificate .pem files (like supabase-ca-chain.pem) are public and OK to commit
# Private key .pem files should use .key extension instead

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
pnpm-lock.yaml

# Build outputs
dist/
build/
.next/
.gocache/

# Logs
*.log
frontend/.env.*


# Misc
*.cache/
*__debug*
*.tsbuildinfo

# pnpm
.pnpm-store/
frontend/.pnpm-store/

# Playwright e2e
frontend/e2e/*-snapshots/
frontend/playwright-report/
frontend/test-results/

# Playwright MCP screenshots
.playwright-mcp/

# Temporary output files
output.json
output.txt
