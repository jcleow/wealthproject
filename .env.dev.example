# Local development defaults (used by docker-compose.dev.yml and run-ui if you copy/symlink to .env).

# Core server config
PORT=8080
API_VERSION=v1
REQUEST_TIMEOUT=30
MAX_REQUEST_SIZE=10485760

# Secrets (development only; replace for real deployments)
JWT_SECRET=dev-jwt-secret
BACKEND_SHARED_SECRET=dev-shared-secret

# Database (local Postgres container)
POSTGRES_DB=financial_chat
POSTGRES_USER=financial_user
POSTGRES_PASSWORD=${DB_PASSWORD}
POSTGRES_HOST=postgres
DATABASE_URL=postgres://financial_user:${DB_PASSWORD}@postgres:5432/financial_chat?sslmode=disable

# LLM Provider API Keys (optional for dev; leave blank to disable calls)
PRIMARY_LLM=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=0

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-sonnet-20240229
ANTHROPIC_MAX_TOKENS=0

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_TOKENS=0

# Session / usage
SESSION_TTL_HOURS=24
SESSION_CLEANUP_INTERVAL_MINUTES=60
USAGE_TRACKING_ENABLED=true

# Frontend / BFF
GO_BACKEND_URL=http://localhost:8080
REACT_APP_BACKEND_URL=http://localhost:8080
BETTERAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTERAUTH_URL=http://localhost:3000
NEXT_PUBLIC_USE_TIMELINE_V2=false
