# Development: IP-based access on port 80
:80 {
    # All API requests -> frontend (Next.js BFF handles auth + proxies to backend)
    handle /api/* {
        reverse_proxy frontend:3001
    }

    # Everything else -> frontend
    handle {
        reverse_proxy frontend:3001
    }
}

# Production: Replace YOUR_DOMAIN with your actual domain (e.g., example.com)
